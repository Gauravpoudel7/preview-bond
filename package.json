{
  "name": "preview-bond",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "anchor test",
    "demo:happy": "ts-node --transpile-only -r tsconfig-paths/register scripts/demo/demo_happy.ts",
    "demo:attack": "ts-node --transpile-only -r tsconfig-paths/register scripts/demo/demo_attack.ts",
    "demo:slippage": "ts-node --transpile-only -r tsconfig-paths/register scripts/demo/demo_slippage.ts",
    "dev:web": "pnpm --filter preview-bond-web dev"
  },
  "dependencies": {
    "@solana/web3.js": "^1.87.0",
    "@coral-xyz/anchor": "0.30.1",
    "@preview-bond/shared": "workspace:*",
    "@preview-bond/simulator": "workspace:*"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "tsconfig-paths": "^4.2.0"
  }
}
