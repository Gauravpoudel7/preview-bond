{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@preview-bond/shared": ["packages/shared/index.ts"],
      "@preview-bond/simulator": ["packages/simulator/index.ts"],
      "@preview-bond/types": ["packages/types/index.ts"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
